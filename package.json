{
  "name": "@fegnze/dsh-mcp-manager",
  "version": "0.1.3",
  "license": "MIT",
  "author": "fegnze",
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fegnze/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/fegnze/dsh-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/fegnze/dsh-mcp-manager/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "description": "Manage native DSH MCP connections and import MCP server configurations",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/zh.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
